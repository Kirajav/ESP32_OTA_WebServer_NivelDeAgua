    // Probar conexión WiFi con información detallada
    server.on("/test-connection", HTTP_GET, [](AsyncWebServerRequest *request) {
        Serial.println("🧪 Probando conexión WiFi...");
        
        String json = "{";
        if (WiFi.status() == WL_CONNECTED) {
            json += "\"success\":true,";
            json += "\"message\":\"Conexión exitosa\",";
            json += "\"details\":{";
            json += "\"ssid\":\"" + WiFi.SSID() + "\",";
            json += "\"ip\":\"" + WiFi.localIP().toString() + "\",";
            json += "\"rssi\":" + String(WiFi.RSSI()) + ",";
            json += "\"gateway\":\"" + WiFi.gatewayIP().toString() + "\",";
            json += "\"dns\":\"" + WiFi.dnsIP().toString() + "\"";
            json += "}";
        } else {
            String status_text = "Desconocido";
            switch(WiFi.status()) {
                case WL_IDLE_STATUS: status_text = "WiFi en espera"; break;
                case WL_NO_SSID_AVAIL: status_text = "SSID no disponible"; break;
                case WL_SCAN_COMPLETED: status_text = "Escaneo completado"; break;
                case WL_CONNECT_FAILED: status_text = "Conexión fallida"; break;
                case WL_CONNECTION_LOST: status_text = "Conexión perdida"; break;
                case WL_DISCONNECTED: status_text = "Desconectado"; break;
            }
            json += "\"success\":false,";
            json += "\"message\":\"Sin conexión WiFi\",";
            json += "\"details\":{";
            json += "\"status\":\"" + status_text + "\",";
            json += "\"ap_mode\":true,";
            json += "\"ap_ip\":\"" + WiFi.softAPIP().toString() + "\"";
            json += "}";
        }
        json += "}";
        
        request->send(200, "application/json", json);
    });
    

    
    // Control manual de pantalla (encender/apagar)
    server.on("/toggle-display", HTTP_POST, [this](AsyncWebServerRequest *request) {
        Serial.println("🖥️ Toggle pantalla OLED...");
        
        if (this->display_manager.isDisplaySleeping()) {
            this->display_manager.wakeUpDisplay();
            request->send(200, "application/json", "{\"success\":true,\"message\":\"Pantalla encendida\",\"status\":\"on\"}");
