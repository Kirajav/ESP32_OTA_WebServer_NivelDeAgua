    // Guardar configuración del sensor (incluyendo intervalo de sensado)
    server.on("/save-sensor", HTTP_POST, [this](AsyncWebServerRequest *request) {
        Serial.println("📏 Guardando configuración del sensor...");
        
        SensorConfig& sensorConfig = this->config_manager.getSensorConfig();
        
        if (request->hasParam("min", true)) {
            sensorConfig.setMinDistance(request->getParam("min", true)->value().toFloat());
        }
        if (request->hasParam("max", true)) {
            sensorConfig.setMaxHeight(request->getParam("max", true)->value().toFloat());
        }
        if (request->hasParam("interval", true)) {
            this->config_manager.setUpdateInterval(request->getParam("interval", true)->value().toInt());
        }
        
        if (this->config_manager.save()) {
            Serial.println("✅ Configuración del sensor guardada");
            Serial.println("📏 Min: " + String(sensorConfig.getMinDistance()) + "cm, Max: " + String(sensorConfig.getMaxHeight()) + "cm");
            Serial.println("⏱️ Intervalo de actualización: " + String(this->config_manager.getUpdateInterval()) + " segundos");
