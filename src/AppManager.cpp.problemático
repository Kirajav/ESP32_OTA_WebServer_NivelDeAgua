            request->send(400, "application/json", "{\"success\":false,\"message\":\"Error en formato JSON\"}");
            return;
        }
        
        String ssid = doc["ssid"].as<String>();
        
        if (ssid.isEmpty()) {
            request->send(400, "application/json", "{\"success\":false,\"message\":\"SSID requerido\"}");
            return;
        }
        
        Serial.printf("🗑️ Eliminando red: %s\n", ssid.c_str());
        
        bool success = config_manager.getNetworkConfig().removeWiFiNetwork(ssid);
        
        if (success) {
