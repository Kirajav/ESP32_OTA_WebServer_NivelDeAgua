    // Guardar toda la configuración y reiniciar con WiFi predeterminado
    server.on("/save-all-and-restart", HTTP_POST, [this](AsyncWebServerRequest *request) {
        Serial.println("💾🔄 Guardando toda la configuración y reiniciando...");
        
