        this->config_manager.setAPSSID(apSSID);
        this->config_manager.setAPPassword(apPassword);
        this->config_manager.setHostname(hostname);
        
        if (this->config_manager.save()) {
            // Actualizar hostname del ESP32
            WiFi.setHostname(hostname.c_str());
            
            Serial.println("✅ Configuración del AP y hostname guardados");
            request->send(200, "application/json", "{\"success\":true,\"message\":\"Configuración del AP guardada exitosamente\"}");
