            Serial.println("❌ Error estableciendo red predeterminada");
            request->send(500, "application/json", "{\"success\":false,\"message\":\"Red no encontrada\"}");
        }
    });
    
    // Eliminar red WiFi
    server.on("/remove-wifi-network", HTTP_POST, [this](AsyncWebServerRequest *request) {},
    NULL, [this](AsyncWebServerRequest *request, uint8_t *data, size_t len, size_t index, size_t total) {
        Serial.println("🗑️ Eliminando red WiFi...");
        
        StaticJsonDocument<256> doc;
        DeserializationError error = deserializeJson(doc, (char*)data);
        
        if (error) {
