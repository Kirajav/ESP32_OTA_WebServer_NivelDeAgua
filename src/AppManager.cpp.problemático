    // Factory reset - Restaurar configuración por defecto
    server.on("/factory-reset", HTTP_POST, [this](AsyncWebServerRequest *request) {
        Serial.println("🗑️ Iniciando factory reset...");
        
        // Restaurar configuraciones por defecto
        // Restaurar configuración por defecto
        this->config_manager.reset();
        this->config_manager.save();
        
        Serial.println("✅ Factory reset completado");
        request->send(200, "application/json", "{\"success\":true,\"message\":\"Configuración restablecida. Reiniciando...\"}");
        
        // Reiniciar después de 2 segundos
        delay(2000);
        ESP.restart();
    });
    
    // Servir archivos estáticos
    server.serveStatic("/", SPIFFS, "/");
    
    // ===== INICIALIZAR SERVIDOR =====
    server.begin();
    Serial.printf("✅ Web Server iniciado en modo: %s\n", 
                  portal_active ? "PORTAL CAUTIVO" : "SENSOR NORMAL");
}

