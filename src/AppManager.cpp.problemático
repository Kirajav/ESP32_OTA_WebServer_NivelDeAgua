    // Guardar configuración WiFi
    server.on("/save-wifi", HTTP_POST, [this](AsyncWebServerRequest *request) {
        Serial.println("💾 Guardando configuración WiFi...");
        
        String ssid = "";
        String password = "";
        
        // Obtener parámetros del POST
        if (request->hasParam("ssid", true)) {
            ssid = request->getParam("ssid", true)->value();
        }
        if (request->hasParam("password", true)) {
            password = request->getParam("password", true)->value();
        }
        
        if (ssid.length() > 0) {
            Serial.println("💾 Guardando WiFi: " + ssid + " (password: " + (password.length() > 0 ? "***" : "vacía") + ")");
            
            // Usar ConfigManager para guardar la configuración WiFi
            Serial.println("🔧 Llamando config_manager.setWiFiCredentials...");
            Serial.printf("🔧 SSID: '%s', Password length: %d\n", ssid.c_str(), password.length());
            bool saveSuccess = config_manager.setWiFiCredentials(ssid, password);
            Serial.printf("🔧 Resultado de setWiFiCredentials: %s\n", saveSuccess ? "true" : "false");
            
            // Verificar lo que se guardó
            Serial.printf("🔧 SSID guardado: '%s'\n", config_manager.getWiFiSSID().c_str());
            Serial.printf("🔧 Password guardado length: %d\n", config_manager.getWiFiPassword().length());
            
            if (saveSuccess) {
                Serial.println("✅ Configuración WiFi guardada exitosamente: " + ssid);
                
                // Intentar conectar a la red WiFi configurada
                Serial.println("🔄 Intentando conectar a: " + ssid);
                WiFi.begin(ssid.c_str(), password.c_str());
                
                // Responder inmediatamente y conectar en segundo plano
                AsyncWebServerResponse *response = request->beginResponse(200, "application/json", "{\"success\":true,\"message\":\"WiFi guardado exitosamente. Conectando...\"}");
                response->addHeader("Cache-Control", "no-cache, no-store, must-revalidate");
                response->addHeader("Pragma", "no-cache");
                response->addHeader("Expires", "0");
                request->send(response);
                Serial.println("✅ Respuesta HTTP SUCCESS enviada al cliente");
                
                // Programar chequeo de conexión después de un delay
                connectionCheckTimer = millis() + 10000; // 10 segundos
                checkingConnection = true;
                
            } else {
                Serial.println("❌ Error guardando configuración WiFi en ConfigManager");
                AsyncWebServerResponse *response = request->beginResponse(500, "application/json", "{\"success\":false,\"message\":\"Error: Credenciales WiFi inválidas\"}");
                response->addHeader("Cache-Control", "no-cache, no-store, must-revalidate");
                response->addHeader("Pragma", "no-cache");
                response->addHeader("Expires", "0");
                request->send(response);
                Serial.println("❌ Respuesta HTTP ERROR enviada al cliente");
