                                 "<body><script>window.location.href='/';</script>"
                                 "<p>Redirigiendo al portal...</p></body></html>";
            request->send(200, "text/html", redirectHTML);
        } else {
            // En modo sensor, devolver 404 normal
            request->send(404, "text/plain", "❌ Página no encontrada");
        }
    });
}

